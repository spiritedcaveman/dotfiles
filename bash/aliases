# web
#######################

# picture on term

alias w3m='w3m -sixel'

W3M_BIN="w3m -sixel"

wmm() {
    if [ -n "$1" ]; then
        $W3M_BIN "https://lore.kernel.org/linux-mm/?q=$1"
    else
        $W3M_BIN "https://lore.kernel.org/linux-mm/"
    fi
}

