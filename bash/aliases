# Enable colors for core utilities
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'

alias tree='tree -C'


alias fusion= 'QT_STYLE_OVERRIDE=Fusion'


alias stackcollapse-perf.pl='/path/to/FlameGraph/stackcollapse-perf.pl'
alias flamegraph.pl='/path/to/FlameGraph/flamegraph.pl'


# Stream bandcamp
alias mpva='mpv --no-video --audio-display=no --ytdl-format="bestaudio"'


alias nosleep='systemd-inhibit --what=idle:sleep --who="spiritedcaveman" \
--why="Preventing sleep temporarily" sleep infinity'

alias ..='cd ..'
alias ker6='cd ~/Documents/kernel/v6-0'

# Hardcoded display alias
alias swayimg='WAYLAND_DISPLAY=wayland-1 swayimg'
