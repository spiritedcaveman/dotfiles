" =============================================================================
" --- PLUGIN SECTION --- 
" =============================================================================

call plug#begin('~/.vim/plugged')
" UI tab colours
Plug 'vim-airline/vim-airline'
" C navigtor to swtich between source files and header files quickly
Plug 'vim-scripts/a.vim'
" Git wrapper
Plug 'tpope/vim-fugitive'
" Nerd tree
Plug 'preservim/nerdtree'
" Fuzzy finder
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
" Tmux companion
Plug 'christoomey/vim-tmux-navigator'
" Discord presence
Plug 'vimsence/vimsence'
" Use the pre-built binary to avoid installing nodejs/yarn
" Plug 'iamcco/markdown-preview.nvim', { 'do': { -> mkdp#util#install() }, 'for': ['markdown', 'vim-plug'] }
call plug#end()


" =============================================================================
" GENERAL UI
" =============================================================================

set nocompatible
syntax on
colorscheme desert
filetype plugin indent on
set termguicolors
set t_Co=256
set background=dark

" --- TRANSPARENCY FIX ---
highlight Normal       guibg=NONE ctermbg=NONE
highlight NonText      guibg=NONE ctermbg=NONE
highlight LineNr       guibg=NONE ctermbg=NONE
highlight SignColumn   guibg=NONE ctermbg=NONE
highlight EndOfBuffer  guibg=NONE ctermbg=NONE


" =============================================================================
" UI TWEAK
" =============================================================================

set number
set relativenumber
set cursorline

" Only underline the current line, no gray background block
"highlight CursorLine cterm=underline gui=underline guibg=NONE ctermbg=NONE guisp=#585858

" Gray background block
"highlight CursorLine cterm=NONE ctermbg=234



" Clean gutter-only current line
highlight CursorLine cterm=NONE gui=NONE guibg=NONE ctermbg=NONE
highlight CursorLineNr cterm=bold,underline gui=bold,underline ctermfg=11 guifg=#98c379



" Set the boundary line at column 80 for kernel standards
set colorcolumn=81,101

" For GUI / True-Color Terminals
highlight ColorColumn guibg=#98c379 guifg=NONE

" For 256-color Terminals
highlight ColorColumn ctermbg=234 ctermfg=NONE



set mouse=a
set laststatus=2


" Force Vim to render highlights smoothly while scrolling
set ttyfast
set lazyredraw

" --- C-STYLE ---
set tabstop=8
set shiftwidth=8	
set noexpandtab		" Real tabs for kernel work
set smartindent
set shiftround
set autoindent


" =============================================================================
" --- MINIMALIST AIRLINE  ---
" =============================================================================

let g:airline_symbols_ascii = 1
let g:airline#extensions#whitespace#enabled = 0
let g:airline_section_y = '%{&fileformat}'
let g:airline_section_z = '%l:%c'

" colorscheme's mode colors
let g:airline_theme='dark'




" =============================================================================
" --- Markdown Preview Logic ---
" =============================================================================

" Toggle preview with Leader+p (usually \p)
nmap <Leader>p <Plug>MarkdownPreviewToggle
nmap <Leader>s <Plug>MarkdownPreviewStop
" Performance & Behavior
let g:mkdp_auto_start = 0          " Don't open a browser every time you touch a .md file
let g:mkdp_auto_close = 1          " Close the browser tab when you switch buffers (clean)
let g:mkdp_refresh_slow = 0         " Real-time refresh (your 14700 can handle it easily)
let g:mkdp_theme = 'dark'           " Matches your Dracula/Dark setup
let g:mkdp_open_to_the_world = 1

" Browser Path
let g:mkdp_browser = '/usr/bin/firefox'


" =============================================================================
" --- Mathematical Maturity (KaTeX) ---
" =============================================================================

let g:mkdp_preview_options = {
    \ 'mkit': {},
    \ 'katex': {'macros': {'\R': '\mathbb{R}'}},
    \ 'uml': {},
    \ 'maid': {},
    \ 'disable_sync_scroll': 0,
    \ 'sync_scroll_type': 'middle',
    \ 'hide_yaml_meta': 1
    \ }




" =============================================================================
" Advanced hacks
" =============================================================================

" turn on to paste long buffer
set pastetoggle=<F2>


" Automatically search for tags file in parent directories
set tags=./tags;,tags;


" =============================================================================
" x86 code reading
" =============================================================================

" clear the path and only add the local project directories
set path=.,include,arch/x86/include,,

" ensure Vim knows to try adding .h to names
set suffixesadd=.h

" c and not cpp
let g:c_syntax_for_h = 1

" handle the < > and " " in C includes
"set includeid=\%(\k\|[./]\)\+

" tell NERDTree NEVER to change Vim's current working directory
let g:NERDTreeChDirMode = 0

" make sure Vim isn't auto-changing directory based on the active tab/buffer
set noautochdir




" =============================================================================
" --- discord presence ---
" =============================================================================

" Vimsence Configuration
let g:vimsence_client_id = '439476230543245312'

" change small image text and icon from Neovim to standard Vim
let g:vimsence_small_text = 'Vim'
let g:vimsence_small_image = 'vim'

" Status formatting
let g:vimsence_editing_details = 'editing: {}'
let g:vimsence_editing_state = 'working on: {}'

" File explorer status
let g:vimsence_file_explorer_text = 'In NERDTree'
let g:vimsence_file_explorer_details = 'Looking for files'

" Custom filetype icons mapping
" replace 'python', 'javascript', etc. with your actual filetypes
let g:vimsence_custom_icons = {
\   'python': 'python',
\   'javascript': 'javascript',
\   'html': 'html'
\ }

