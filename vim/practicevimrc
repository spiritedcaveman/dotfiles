" =============================================================================
" --- CSCOPE --- 
" =============================================================================


if has("cscope")
    set cscopetag
    set cscopeprg=cscope

    " Walk up directories to find cscope.out in kernel root
    let s:cscope_file = findfile("cscope.out", ".;")
    if !empty(s:cscope_file)
        silent execute "cs add" . fnameescape(s:cscope_file)
    elseif $CSCOPE_DB != ""
        silent cs add $CSCOPE_DB
    endif

    set csto=0
    set cst
    set nocsverb
endif

" =============================================================================
" --- Custom Cscope Shortcuts ---
" =============================================================================

" --- Complete Cscope Query Mappings (Ordered per Menu) ---
nnoremap \a :cs find a <C-R>=expand("<cword>")<CR><CR>
nnoremap \c :cs find c <C-R>=expand("<cword>")<CR><CR>
nnoremap \d :cs find d <C-R>=expand("<cword>")<CR><CR>
nnoremap \e :cs find e <C-R>=expand("<cword>")<CR><CR>
nnoremap \f :cs find f <C-R>=expand("<cfile>")<CR><CR>
nnoremap \g :cs find g <C-R>=expand("<cword>")<CR><CR>
nnoremap \i :cs find i ^<C-R>=expand("<cfile>")<CR>$<CR>
nnoremap \s :cs find s <C-R>=expand("<cword>")<CR><CR>
nnoremap \t :cs find t <C-R>=expand("<cword>")<CR><CR>

" --- Utility Cscope Commands ---
nnoremap \h :cs help<CR>
nnoremap \r :cs reset<CR>
nnoremap \o :cs show<CR>

" #ifdef folding(need more hacks)
set foldmethod=expr
set foldexpr=PreprocessorFold(v:lnum)

function! PreprocessorFold(lnum)
    let line = getline(a:lnum)
    if line =~# '^\s*#\s*if\(ndef\)\?'
        return 'a1'
    elseif line =~# '^\s*#\s*endif'
        return 's1'
    endif
    return '='
endfunction

set foldcolumn=1   " Show fold column on the left (adjust width 1 to 4)
