# Enable custom color (inversion) on startup
startup_commands toggle_custom_color

# Professional Dark Mode (Background, Text)
# These are normalized RGB (0.0 - 1.0)
custom_background_color    0.1 0.1 0.1
custom_text_color          0.8 0.8 0.8


# 1. Disable the smart overview rerendering (the "black screen" culprit)
rerender_overview 0

# 2. Simplify the TOC (prevents the 't' hang)
flat_toc 1

# 3. Increase the startup performance by disabling pre-indexing
should_launch_new_window 1

# jesus christ this app by default hangs to bake the pre  built hyperlinks
align_link_dest_to_top 1


# 1. Limit the page cache 
page_cache_size 5

# 2. Stop rendering ahead
should_draw_unrendered_pages 0

# 3. Disable pre-loading of the next document
prerender_next_page 0

# 4. Limit texture size
texture_cache_size 512
