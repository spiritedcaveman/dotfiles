# --- General UI (Desert Theme) ---
color normal      white          default
color error       brightred      default
color tilde       brightblack    default
color message     cyan           default
color attachment  brightmagenta  default
color search      black          yellow
color status      black          cyan    # Airline Blue Bar
color indicator   black          yellow  # Airline Selection

# --- Index (Inbox List) ---
color index	  brightgreen	 default  "~N"  # New messages
color index	  brightgreen    default  "~O"  # Old but unread messages
color index       red            default  "~D"
color index       magenta        default  "~F"
color index       blue           default  "~T"

# --- Inside the Email (The Pager) ---
color hdrdefault  cyan           default
color signature   brightblack    default

# --- Fixed Quote Syntax (The "d" matters!) ---
color quoted      green          default
color quoted1     yellow         default
color quoted2     red            default
color quoted3     magenta        default

# --- Fixed URL Regex (No "Invalid Range") ---
color body        yellow         default  "(https?|ftp|news)://[^[:space:]]+"
color body        brightblue     default  "[-a-z_0-9.%]+@[-a-z_0-9.]+\.[-a-z][-a-z]+"


#  scrolling inside the email
bind pager d half-down
bind pager u half-up
bind pager j next-line
bind pager k previous-line
